# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=gateway
HTTP_PORT=8090
WS_PORT=8091
LOG_LEVEL=info
LOG_FORMAT=console

# ==================================================
# JWT (должен совпадать с auth-service)
# ==================================================

JWT_SECRET=OFkgmGHUF58UgV97xZiFwMybW0WzY5irMdQcX3rMiHt

# ==================================================
# Rate limiting
# ==================================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ==================================================
# CORS
# ==================================================

CORS_ALLOWED_ORIGINS=trip-builder.ru

# ==================================================
# Адреса микросервисов (для docker-compose используем имена сервисов)
# ==================================================

AUTH_URL=http://auth:8081
USER_URL=http://user:8082
ROUTE_URL=http://route:8083
EVENT_URL=http://event:8084
TASK_URL=http://task:8085
CHAT_URL=http://chat:8086
CHAT_WS_URL=ws://chat:8088
MEDIA_URL=http://media:8087
SEARCH_URL=http://search:8088
NOTIFICATION_URL=http://notification:8089



# Интервал проверки здоровья сервисов (например, 30s, 1m, 5m)
HEALTH_CHECK_INTERVAL=168h