SERVICE_NAME=gateway
HTTP_PORT=8090
LOG_LEVEL=info
LOG_FORMAT=json

JWT_SECRET=real-secret-for-test-32-bytes-at-least

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

CORS_ALLOWED_ORIGINS=https://my.domain.ru

AUTH_URL=http://auth:9001
USER_URL=http://user:9002
ROUTE_URL=http://route:9003
EVENT_URL=http://event:9004
TASK_URL=http://task:9005
CHAT_URL=http://chat:9006
MEDIA_URL=http://media:9007
SEARCH_URL=http://search:9008
NOTIFICATION_URL=http://notification:9009