SERVICE_NAME=gateway
HTTP_PORT=8090
LOG_LEVEL=info
LOG_FORMAT=json

JWT_SECRET=real-secret-for-test-32-bytes-at-least

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

CORS_ALLOWED_ORIGINS=*

AUTH_URL=http://trip-builder-backend-auth-test:9101
USER_URL=http://trip-builder-backend-user-test:9102
ROUTE_URL=http://trip-builder-backend-route-test:9103
EVENT_URL=http://trip-builder-backend-event-test:9104
TASK_URL=http://trip-builder-backend-task-test:9105
CHAT_URL=http://trip-builder-backend-chat-test:9106
MEDIA_URL=http://trip-builder-backend-media-test:9107
SEARCH_URL=http://trip-builder-backend-search-test:9108
NOTIFICATION_URL=http://trip-builder-backend-notification-test:9109

# Интервал проверки здоровья сервисов (например, 30s, 1m, 5m)
HEALTH_CHECK_INTERVAL=30s