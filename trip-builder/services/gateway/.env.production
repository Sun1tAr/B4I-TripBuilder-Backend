SERVICE_NAME=gateway
HTTP_PORT=8090
LOG_LEVEL=info
LOG_FORMAT=json

JWT_SECRET=real-secret-for-test-32-bytes-at-least

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

CORS_ALLOWED_ORIGINS=*

AUTH_URL=http://trip-builder-backend-auth-test:8081
USER_URL=http://trip-builder-backend-user-test:8082
ROUTE_URL=http://trip-builder-backend-route-test:8083
EVENT_URL=http://trip-builder-backend-event-test:8084
TASK_URL=http://trip-builder-backend-task-test:8085
CHAT_URL=http://trip-builder-backend-chat-test:8086
MEDIA_URL=http://trip-builder-backend-media-test:8087
SEARCH_URL=http://trip-builder-backend-search-test:8088
NOTIFICATION_URL=http://trip-builder-backend-notification-test:8089

# Интервал проверки здоровья сервисов (например, 30s, 1m, 5m)
HEALTH_CHECK_INTERVAL=5m