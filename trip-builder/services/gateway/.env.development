SERVICE_NAME=gateway
HTTP_PORT=8090
LOG_LEVEL=debug
LOG_FORMAT=console

JWT_SECRET=dev-secret-key-32-bytes-for-development-only

RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1m

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

AUTH_URL=http://auth:9101
USER_URL=http://user:9102
ROUTE_URL=http://route:9103
EVENT_URL=http://event:9104
TASK_URL=http://task:9105
CHAT_URL=http://chat:9106
MEDIA_URL=http://media:9107
SEARCH_URL=http://search:9108
NOTIFICATION_URL=http://notification:9109