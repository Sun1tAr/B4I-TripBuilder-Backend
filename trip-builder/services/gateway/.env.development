SERVICE_NAME=gateway
HTTP_PORT=8090
LOG_LEVEL=debug
LOG_FORMAT=console

JWT_SECRET=dev-secret-key-32-bytes-for-development-only

RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1m

CORS_ALLOWED_ORIGINS=*

AUTH_URL=http://trip-builder-backend-auth-dev:8081
USER_URL=http://trip-builder-backend-user-dev:8082
ROUTE_URL=http://trip-builder-backend-route-dev:8083
EVENT_URL=http://trip-builder-backend-event-dev:8084
TASK_URL=http://trip-builder-backend-task-dev:8085
CHAT_URL=http://trip-builder-backend-chat-dev:8086
MEDIA_URL=http://trip-builder-backend-media-dev:8087
SEARCH_URL=http://trip-builder-backend-search-dev:8088
NOTIFICATION_URL=http://trip-builder-backend-notification-dev:8089

# Интервал проверки здоровья сервисов (например, 30s, 1m, 5m)
HEALTH_CHECK_INTERVAL=30s