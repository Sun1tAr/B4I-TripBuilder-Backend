# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=gateway
HTTP_PORT=8090
LOG_LEVEL=debug
LOG_FORMAT=console

# ==================================================
# JWT (должен совпадать с auth-service)
# ==================================================

JWT_SECRET=your-256-bit-secret-min-32-chars-please-change

# ==================================================
# Rate limiting
# ==================================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ==================================================
# CORS
# ==================================================

CORS_ALLOWED_ORIGINS=*

# ==================================================
# Адреса микросервисов (для docker-compose используем имена сервисов)
# ==================================================

AUTH_URL=http://trip-builder-backend-auth:8081
USER_URL=http://trip-builder-backend-user:8082
ROUTE_URL=http://localhost:8083
EVENT_URL=http://localhost:8084
TASK_URL=http://localhost:8085
CHAT_URL=http://localhost:8086
MEDIA_URL=http://localhost:8087
SEARCH_URL=http://localhost:8088
NOTIFICATION_URL=http://localhost:8089

#AUTH_URL=http://trip-builder-backend-auth:8081
#USER_URL=http://trip-builder-backend-user:8082

# Интервал проверки здоровья сервисов (например, 30s, 1m, 5m)
HEALTH_CHECK_INTERVAL=30s