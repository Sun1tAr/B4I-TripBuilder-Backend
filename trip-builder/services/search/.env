# Service
SERVICE_NAME=search
HTTP_PORT=8088
LOG_LEVEL=debug
LOG_FORMAT=console

# Elasticsearch
ELASTICSEARCH_ADDRS=http://trip-builder-backend-elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Kafka
KAFKA_BROKERS=trip-builder-backend-kafka:9092

# Kafka topics
KAFKA_TOPIC_ROUTE_CREATED=route.created
KAFKA_TOPIC_ROUTE_UPDATED=route.updated
KAFKA_TOPIC_ROUTE_DELETED=route.deleted
KAFKA_TOPIC_EVENT_CREATED=event.created
KAFKA_TOPIC_EVENT_UPDATED=event.updated
KAFKA_TOPIC_EVENT_DELETED=event.deleted
KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_USER_UPDATED=user.updated

# URLs других сервисов (для начальной синхронизации)
ROUTE_SERVICE_URL=http://trip-builder-backend-route:8083
EVENT_SERVICE_URL=http://trip-builder-backend-event:8084
USER_SERVICE_URL=http://trip-builder-backend-user:8082

# Периодическая переиндексация (0 = отключено)
INITIAL_SYNC_INTERVAL=24h

# Пагинация
MAX_RESULT_WINDOW=10000