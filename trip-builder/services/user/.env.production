SERVICE_NAME=user-service
HTTP_PORT=8082
LOG_LEVEL=info
LOG_FORMAT=json

JWT_SECRET=your-256-bit-secret-min-32-chars-please-change

AVATAR_MAX_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif

KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_USER_UPDATED=user.updated
KAFKA_TOPIC_USER_DELETED=user.deleted
KAFKA_TOPIC_ROUTE_CREATED=route.created
KAFKA_TOPIC_EVENT_COMPLETED=event.completed
KAFKA_TOPIC_MEDIA_UPLOADED=media.uploaded

DB_HOST=postgres-test
DB_PORT=5432
