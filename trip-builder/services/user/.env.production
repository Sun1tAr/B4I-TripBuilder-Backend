DB_PASSWORD=auth_pass_test
DB_NAME=trip-builder
DB_SCHEMA=tpb_user
DB_SSLMODE=require

KAFKA_BROKERS=kafka-test:9092
KAFKA_GROUP_ID=user-test

MIGRATION_ENABLED=true
