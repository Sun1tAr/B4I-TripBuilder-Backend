SERVICE_NAME=user-service
HTTP_PORT=8082
LOG_LEVEL=debug
LOG_FORMAT=console



AVATAR_MAX_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif

KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_USER_UPDATED=user.updated
KAFKA_TOPIC_USER_DELETED=user.deleted
KAFKA_TOPIC_ROUTE_CREATED=route.created
KAFKA_TOPIC_EVENT_COMPLETED=event.completed
KAFKA_TOPIC_MEDIA_UPLOADED=media.uploaded

DB_HOST=postgres-dev
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev
DB_NAME=trip-builder
DB_SCHEMA=tpb_user
DB_SSLMODE=disable

KAFKA_BROKERS=kafka-dev:9092
KAFKA_GROUP_ID=user-dev

MIGRATION_ENABLED=true
MIGRATION_VERSION=0

REDIS_ADDR=redis-dev:6379
REDIS_PASSWORD=
REDIS_DB=0

MEDIA_SERVICE_URL=http://trip-builder-backend-media-dev:8087
EVENT_SERVICE_URL=http://trip-builder-backend-event-dev:8084

RETRY_TOPIC=user.events.retry
DLQ_TOPIC=user.events.dlq

RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_BACKOFF=100ms
RETRY_MAX_BACKOFF=30s