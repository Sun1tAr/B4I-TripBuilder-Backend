# ==================================================
# Локальная разработка
# ==================================================

SERVICE_NAME=user-service
HTTP_PORT=8082
LOG_LEVEL=info
LOG_FORMAT=console

# ==================================================
# База данных PostgreSQL
# ==================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trip-builder
DB_SCHEMA=tpb_user
DB_SSLMODE=disable

# ==================================================
# Kafka
# ==================================================

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=auth-group

# ==================================================
# Redis
# ==================================================

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0