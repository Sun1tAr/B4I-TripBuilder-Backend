# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=user-service
HTTP_PORT=8082
LOG_LEVEL=info
LOG_FORMAT=console

# ==================================================
# Аутентификация и безопасность
# ==================================================

JWT_SECRET=your-256-bit-secret-min-32-chars-please-change

# ==================================================
# Загрузка файлов
# ==================================================

AVATAR_MAX_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif

# ==================================================
# Kafka (для событий)
# ==================================================

KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_USER_UPDATED=user.updated
KAFKA_TOPIC_USER_DELETED=user.deleted

# ==================================================
# Миграции
# ==================================================

MIGRATION_ENABLED=true
MIGRATION_VERSION=0  # 0 = последняя версия

# ==================================================
# База данных PostgreSQL
# ==================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trip-builder
DB_SCHEMA=tpb_user
DB_SSLMODE=disable

# ==================================================
# Kafka
# ==================================================

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=user-group

# ==================================================
# Redis
# ==================================================

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================================================
# URL других микросервисов
# ==================================================

# Media Service (для загрузки аватаров)
MEDIA_SERVICE_URL=http://media:8087

# Event Service (для получения событий пользователя)
EVENT_SERVICE_URL=http://event:8084

# ==================================================
# Kafka (retry и dead letter queue)
# ==================================================

# Топики для повторных попыток при недоступности других сервисов
RETRY_TOPIC=user.events.retry
DLQ_TOPIC=user.events.dlq

# Настройки повторных попыток
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_BACKOFF=100ms
RETRY_MAX_BACKOFF=30s