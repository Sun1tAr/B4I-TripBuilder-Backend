# Service
SERVICE_NAME=media-service
HTTP_PORT=8087
LOG_LEVEL=debug
LOG_FORMAT=console

# Database
DB_HOST=postgres-dev
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev
DB_NAME=trip-builder
DB_SCHEMA=tpb_media
DB_SSLMODE=disable

# MinIO
MINIO_ENDPOINT=minio-dev:9000
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_pass_dev
MINIO_BUCKET=trip-builder
MINIO_USE_SSL=false

# Limits
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600

# Kafka
KAFKA_BROKERS=kafka-dev:9092
KAFKA_GROUP_ID=media-group

KAFKA_TOPIC_MEDIA_UPLOADED=media.uploaded

# Other services
EVENT_SERVICE_URL=http://trip-builder-backend-event-dev:8084

# Migrations
MIGRATION_ENABLED=true

# HTTP Client
HTTP_CLIENT_TIMEOUT=30s

PUBLIC_MEDIA_URL=http://denchik2376.fvds.ru/dev/trip-builder-api/v1