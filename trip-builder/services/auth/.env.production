# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=auth-service
HTTP_PORT=8081
LOG_LEVEL=info
LOG_FORMAT=console

# ==================================================
# Аутентификация и безопасность
# ==================================================

TOKEN_LIFETIME=1h
REFRESH_LIFETIME=168h
BCRYPT_COST=10
JWT_SECRET=OFkgmGHUF58UgV97xZiFwMybW0WzY5irMdQcX3rMiHt

# ==================================================
# Rate limiting для логина
# ==================================================

RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=5m


# ==================================================
# База данных PostgreSQL
# ==================================================

DB_HOST=postgres
DB_PORT=5432
DB_USER=Sun1tAr_developer
DB_PASSWORD=B4eTeam23736!
DB_NAME=trip-builder
DB_SCHEMA=tpb_auth
DB_SSLMODE=disable

# ==================================================
# Kafka (для отправки событий и уведомлений)
# ==================================================

KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=auth-group
KAFKA_TOPIC_USER_CREATED=user.created

# ==================================================
# Redis (для rate limiting)
# ==================================================

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================================================
# Health check интервалы
# ==================================================

REDIS_HEALTH_INTERVAL=168h
KAFKA_HEALTH_INTERVAL=168h
KAFKA_DIAL_TIMEOUT=168h
REDIS_PING_TIMEOUT=168h

TOKEN_CLEANUP_INTERVAL=5m

# ==================================================
# Миграции
# ==================================================

MIGRATION_ENABLED=true
MIGRATION_VERSION=0

USER_SERVICE_URL=http://user:8082

# Token lifetimes
VERIFICATION_TOKEN_LIFETIME=24h
RESET_PASSWORD_TOKEN_LIFETIME=1h

KAFKA_TOPIC_PASSWORD_RESET=password.reset