SERVICE_NAME=auth-service
HTTP_PORT=8081
LOG_LEVEL=info
LOG_FORMAT=json

TOKEN_LIFETIME=15m
REFRESH_LIFETIME=168h
BCRYPT_COST=10

RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=1m

VERIFICATION_URL=http://trip-builder-api/v1/auth/verify
RESET_PASSWORD_URL=http://trip-builder-api/v1/auth/reset-password

DB_HOST=postgres-test
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass_test
DB_NAME=trip-builder
DB_SCHEMA=tpb_auth
DB_SSLMODE=require

KAFKA_BROKERS=kafka-test:9092
KAFKA_GROUP_ID=auth-test

REDIS_ADDR=redis-test:6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_HEALTH_INTERVAL=1m
KAFKA_HEALTH_INTERVAL=1m

TOKEN_CLEANUP_INTERVAL=6h

MIGRATION_ENABLED=true
MIGRATION_VERSION=0