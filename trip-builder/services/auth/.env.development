# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=auth-service
HTTP_PORT=8081
LOG_LEVEL=debug
LOG_FORMAT=console

# ==================================================
# Аутентификация и безопасность
# ==================================================

TOKEN_LIFETIME=168h
REFRESH_LIFETIME=168h
BCRYPT_COST=10
JWT_SECRET=your-256-bit-secret-min-32-chars-please-change

# ==================================================
# Rate limiting для логина
# ==================================================

RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=1m

# ==================================================
# URL для писем (будут использованы в ссылках)
# ==================================================

VERIFICATION_URL=https://my.domain.ru/api/v1/auth/verify
RESET_PASSWORD_URL=https://my.domain.ru/api/v1/auth/reset-password

# ==================================================
# База данных PostgreSQL
# ==================================================

#DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trip-builder
DB_SCHEMA=tpb_auth
DB_SSLMODE=disable

# ==================================================
# Kafka (для отправки событий и уведомлений)
# ==================================================

KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=auth-group
KAFKA_TOPIC_USER_CREATED=user.created

# ==================================================
# Redis (для rate limiting)
# ==================================================

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================================================
# Health check интервалы
# ==================================================

REDIS_HEALTH_INTERVAL=1m
KAFKA_HEALTH_INTERVAL=1m
KAFKA_DIAL_TIMEOUT=3s
REDIS_PING_TIMEOUT=3s

TOKEN_CLEANUP_INTERVAL=5m

# ==================================================
# Миграции
# ==================================================

MIGRATION_ENABLED=true
MIGRATION_VERSION=0

USER_SERVICE_URL=http://trip-builder-backend-user:8082

# Token lifetimes
VERIFICATION_TOKEN_LIFETIME=1m
RESET_PASSWORD_TOKEN_LIFETIME=5m