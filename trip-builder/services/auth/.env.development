SERVICE_NAME=auth-service
HTTP_PORT=8081
LOG_LEVEL=debug
LOG_FORMAT=console

JWT_SECRET=dev-secret-key-32-bytes-for-development-only
TOKEN_LIFETIME=60m
REFRESH_LIFETIME=168h
BCRYPT_COST=4

RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=1m

VERIFICATION_URL=http://dev/trip-builder-api/v1/auth/verify
RESET_PASSWORD_URL=http://dev/trip-builder-api/v1/auth/reset-password

DB_HOST=postgres-dev
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev
DB_NAME=trip-builder
DB_SCHEMA=tpb_auth
DB_SSLMODE=disable

KAFKA_BROKERS=kafka-dev:9092
KAFKA_GROUP_ID=auth-dev

REDIS_ADDR=redis-dev:6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_HEALTH_INTERVAL=1m
KAFKA_HEALTH_INTERVAL=1m

TOKEN_CLEANUP_INTERVAL=30m