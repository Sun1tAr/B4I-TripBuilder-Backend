# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=auth-service
HTTP_PORT=8081
LOG_LEVEL=info
LOG_FORMAT=console

# ==================================================
# Аутентификация и безопасность
# ==================================================

JWT_SECRET=your-256-bit-secret-min-32-chars-please-change
TOKEN_LIFETIME=15
BCRYPT_COST=10

# ==================================================
# База данных PostgreSQL
# ==================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trip-builder          # общая база проекта
DB_SCHEMA=tpb_auth             # схема auth-сервиса
DB_SSLMODE=disable

# ==================================================
# Kafka
# ==================================================

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=auth-group

# ==================================================
# Redis
# ==================================================

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0