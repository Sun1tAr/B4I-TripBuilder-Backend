# Notification Service Configuration
SERVICE_NAME=notification
HTTP_PORT=8089
LOG_LEVEL=info
LOG_FORMAT=console

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev
DB_NAME=trip-builder
DB_SCHEMA=tpb_notification
DB_SSLMODE=disable

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=notification-service
KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_EVENT_INVITE=event.invite
KAFKA_TOPIC_TASK_ASSIGNED=task.assigned
KAFKA_TOPIC_CHAT_MESSAGE=chat.message
KAFKA_TOPIC_EVENT_REMINDER=event.reminder

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=2

# SMTP Configuration (MailHog для локальной разработки)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=trip-builder@yandex.ru
SMTP_PASSWORD=avmxrxgcmmhqtmyv
SMTP_FROM=trip-builder@yandex.ru

# Rate Limiting
EMAIL_DAILY_LIMIT=5
RATE_LIMIT_WINDOW=24h

# External Services
USER_SERVICE_URL=http://trip-builder-backend-user:8082
EVENT_SERVICE_URL=http://trip-builder-backend-event:8084
CHAT_SERVICE_URL=http://trip-builder-backend-chat:8086

# ========== URL для ссылок в письмах (с плейсхолдерами %s) ==========
BASE_URL=http://denchik2376.fvds.ru/dev/trip-builder

# VerifyEmailURL: %s = token
VERIFY_EMAIL_URL=/verify-email?token=%s

# EventInviteURL: %s = eventID
EVENT_INVITE_URL=/my-events?tab=invites

# TaskURL: %s = eventID
TASK_URL=/event/%s?tab=tasks&filter=forMe

# ChatURL: %s = eventID
CHAT_URL=/event/%s

# EventURL: %s = eventID
EVENT_URL=/event/%s

# Migrations
MIGRATION_ENABLED=true
MIGRATION_VERSION=0

# HTTP Client
HTTP_CLIENT_TIMEOUT=10s

KAFKA_TOPIC_PASSWORD_RESET=password.reset
FORGOT_PASSWORD_URL=/reset-password?token=%s