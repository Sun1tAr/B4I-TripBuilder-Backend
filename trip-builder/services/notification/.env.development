# Notification Service Configuration
SERVICE_NAME=notification
HTTP_PORT=8089
LOG_LEVEL=debug
LOG_FORMAT=console

# Database
DB_HOST=postgres-dev
DB_PORT=5432
#DB_USER=postgres
#DB_PASSWORD=postgres
DB_NAME=trip-builder
DB_SCHEMA=tpb_notification
DB_SSLMODE=disable

# Kafka
KAFKA_BROKERS=kafka-dev:9092
KAFKA_GROUP_ID=notification-service
KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_EVENT_INVITE=event.invite
KAFKA_TOPIC_TASK_ASSIGNED=task.assigned
KAFKA_TOPIC_CHAT_MESSAGE=chat.message
KAFKA_TOPIC_EVENT_REMINDER=event.reminder

# Redis
REDIS_ADDR=redis-dev:6379
REDIS_PASSWORD=
REDIS_DB=2

# SMTP Configuration (MailHog для локальной разработки)
SMTP_HOST=mailhog-dev
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@tripbuilder.local

# Rate Limiting
EMAIL_DAILY_LIMIT=10000
RATE_LIMIT_WINDOW=24h

# External Services
USER_SERVICE_URL=http://trip-builder-backend-user-dev:8082
EVENT_SERVICE_URL=http://trip-builder-backend-event-dev:8084
CHAT_SERVICE_URL=http://trip-builder-backend-chat-dev:8086

# ========== URL для ссылок в письмах (с плейсхолдерами %s) ==========
BASE_URL=http://denchik2376.fvds.ru/dev/trip-builder/

# VerifyEmailURL: %s = token
VERIFY_EMAIL_URL=/verify-email?token=%s

# EventInviteURL: %s = eventID
EVENT_INVITE_URL=/my-events?tab=invites

# TaskURL: %s = eventID
TASK_URL=/event/%s?tab=tasks&filter=forMe

# ChatURL: %s = eventID
CHAT_URL=/event/%s

# EventURL: %s = eventID
EVENT_URL=/event/%s

# Migrations
MIGRATION_ENABLED=true
MIGRATION_VERSION=0

# HTTP Client
HTTP_CLIENT_TIMEOUT=10s