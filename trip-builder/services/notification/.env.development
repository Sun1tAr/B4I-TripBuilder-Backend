# Notification Service Configuration (Development)
SERVICE_NAME=notification
HTTP_PORT=9108
LOG_LEVEL=debug
LOG_FORMAT=console

# Database
DB_HOST=postgres-dev
DB_PORT=5422
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev
DB_NAME=trip-builder
DB_SCHEMA=tpb_notification
DB_SSLMODE=disable

# Kafka
KAFKA_BROKERS=kafka-dev:9082
KAFKA_GROUP_ID=notification-service-dev
KAFKA_TOPIC_USER_WELCOME=user.welcome
KAFKA_TOPIC_EVENT_INVITE=event.invite
KAFKA_TOPIC_TASK_ASSIGNED=task.assigned
KAFKA_TOPIC_CHAT_MESSAGE=chat.message
KAFKA_TOPIC_EVENT_REMINDER=event.reminder

# Redis
REDIS_ADDR=redis-dev:6369
REDIS_PASSWORD=
REDIS_DB=2

# SMTP Configuration (для dev используем реальный SMTP или MailHog на сервере)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply-dev@tripbuilder.com

# Rate Limiting
EMAIL_DAILY_LIMIT=5
RATE_LIMIT_WINDOW=24h

# External Services
USER_SERVICE_URL=http://user:9102
EVENT_SERVICE_URL=http://event:9104
CHAT_SERVICE_URL=http://chat:9106

# Frontend URL
FRONTEND_URL=https://dev.tripbuilder.com

# Migrations
MIGRATION_ENABLED=true
MIGRATION_VERSION=0

# HTTP Client
HTTP_CLIENT_TIMEOUT=10s