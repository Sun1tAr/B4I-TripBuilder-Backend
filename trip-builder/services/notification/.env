# Notification Service Configuration
SERVICE_NAME=notification
HTTP_PORT=8088
LOG_LEVEL=debug
LOG_FORMAT=console

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trip-builder
DB_SCHEMA=tpb_notification
DB_SSLMODE=disable

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=notification-service
KAFKA_TOPIC_USER_WELCOME=user.welcome
KAFKA_TOPIC_EVENT_INVITE=event.invite
KAFKA_TOPIC_TASK_ASSIGNED=task.assigned
KAFKA_TOPIC_CHAT_MESSAGE=chat.message
KAFKA_TOPIC_EVENT_REMINDER=event.reminder

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=2

# SMTP Configuration (MailHog для локальной разработки)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@tripbuilder.local

# Rate Limiting
EMAIL_DAILY_LIMIT=5
RATE_LIMIT_WINDOW=24h

# External Services
USER_SERVICE_URL=http://user:8082
EVENT_SERVICE_URL=http://event:8084
CHAT_SERVICE_URL=http://chat:8086

# Frontend URL для ссылок в письмах
FRONTEND_URL=http://localhost:3000

# Migrations
MIGRATION_ENABLED=true
MIGRATION_VERSION=0

# HTTP Client
HTTP_CLIENT_TIMEOUT=10s