# Service
SERVICE_NAME=chat-service
HTTP_PORT=8086
WS_PORT=8088
LOG_LEVEL=info
LOG_FORMAT=console

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev
DB_NAME=trip-builder
DB_SCHEMA=tpb_chat
DB_SSLMODE=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=chat-service

# Kafka topics
KAFKA_TOPIC_CHAT_MESSAGE=chat.message
KAFKA_TOPIC_WAYPOINT_VISITED=waypoint.visited
KAFKA_TOPIC_TASK_COMPLETED=task.completed
KAFKA_TOPIC_MEDIA_UPLOADED=media.uploaded
KAFKA_TOPIC_PARTICIPANT_JOINED=event.participant_joined

# Other services
EVENT_SERVICE_URL=http://trip-builder-backend-event:8084

# Migrations
MIGRATION_ENABLED=true

# HTTP Client
HTTP_CLIENT_TIMEOUT=10s

# WebSocket
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_ALLOWED_ORIGINS=*