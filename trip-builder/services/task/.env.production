# Service
SERVICE_NAME=task-service
HTTP_PORT=8085
LOG_LEVEL=info
LOG_FORMAT=console

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=Sun1tAr_developer
DB_PASSWORD=B4eTeam23736!
DB_NAME=trip-builder
DB_SCHEMA=tpb_task
DB_SSLMODE=disable

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=task-service

# Kafka topics
KAFKA_TOPIC_EVENT_CREATED=event.created
KAFKA_TOPIC_EVENT_UPDATED=event.updated
KAFKA_TOPIC_EVENT_CANCELLED=event.cancelled
KAFKA_TOPIC_TASK_COMPLETED=task.completed
KAFKA_TOPIC_TASK_ASSIGNED=task.assigned

# Other services
EVENT_SERVICE_URL=http://event:8084
USER_SERVICE_URL=http://user:8082

# Migrations
MIGRATION_ENABLED=true

# HTTP Client
HTTP_CLIENT_TIMEOUT=10s

# Генерация задач из шаблонов при создании поездки
GENERATE_TEMPLATES_ENABLED=false