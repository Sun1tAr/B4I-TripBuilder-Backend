# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=event-service
HTTP_PORT=8084
LOG_LEVEL=trace
LOG_FORMAT=console

# ==================================================
# База данных PostgreSQL
# ==================================================

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trip-builder
DB_SCHEMA=tpb_event
DB_SSLMODE=disable

# ==================================================
# Kafka
# ==================================================

KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=event-group

# Топики для событий
KAFKA_TOPIC_EVENT_CREATED=event.created
KAFKA_TOPIC_EVENT_UPDATED=event.updated
KAFKA_TOPIC_EVENT_COMPLETED=event.completed
KAFKA_TOPIC_EVENT_CANCELLED=event.cancelled
KAFKA_TOPIC_WAYPOINT_VISITED=waypoint.visited
KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_PARTICIPANT_JOINED=event.participant_joined
KAFKA_TOPIC_EVENT_DELETED=event.deleted
KAFKA_TOPIC_EVENT_INVITE=event.invite

# ==================================================
# URL других сервисов
# ==================================================

ROUTE_SERVICE_URL=http://trip-builder-backend-route:8083
USER_SERVICE_URL=http://trip-builder-backend-user:8082
AUTH_SERVICE_URL=http://trip-builder-backend-auth:8081

# ==================================================
# Миграции
# ==================================================

MIGRATION_ENABLED=true
MIGRATION_VERSION=0

# ==================================================
# Кроны
# ==================================================

HTTP_CLIENT_TIMEOUT=10s
STATUS_UPDATE_INTERVAL=10m

# Redis для ссылок-приглашений
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# TTL для ссылок-приглашений (7 дней по умолчанию)
INVITE_LINK_TTL=168h