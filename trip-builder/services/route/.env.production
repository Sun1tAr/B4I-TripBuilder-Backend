# ==================================================
# Основные настройки сервиса
# ==================================================

SERVICE_NAME=route-service
HTTP_PORT=8083
LOG_LEVEL=info
LOG_FORMAT=console

# ==================================================
# База данных PostgreSQL
# ==================================================

DB_HOST=postgres
DB_PORT=5432
DB_USER=Sun1tAr_developer
DB_PASSWORD=B4eTeam23736!
DB_NAME=trip-builder
DB_SCHEMA=tpb_route
DB_SSLMODE=disable

# ==================================================
# Kafka
# ==================================================

KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=route-group

# Топики для событий
KAFKA_TOPIC_ROUTE_CREATED=route.created
KAFKA_TOPIC_ROUTE_UPDATED=route.updated
KAFKA_TOPIC_ROUTE_DELETED=route.deleted

# ==================================================
# URL других сервисов
# ==================================================

EVENT_SERVICE_URL=http://event:8084

# ==================================================
# Миграции
# ==================================================

MIGRATION_ENABLED=true
MIGRATION_VERSION=0